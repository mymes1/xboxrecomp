<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by tools/android/project.py (template: templates/xbr-game/app). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- The current presenter draws through SDL's GLES2 renderer; the Vulkan
         presenter (phase 5) is preferred where present. -->
    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:appCategory="game"
        android:isGame="true"
        android:hardwareAccelerated="true"
        android:theme="@style/XbrTheme">

        <!-- singleTop, not singleTask: tapping the icon while a game runs must
             bring the task back with the game on top. A singleTask root would
             take the intent itself and finish the activities above it. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game runs in its own process: the runtime reserves the guest
             address space and owns process-wide state, so every run starts
             fresh, and the launcher survives the game's exit or a crash and
             can show the log. -->
        <activity
            android:name=".XbrGameActivity"
            android:process=":game"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:alwaysRetainTaskState="true"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:theme="@style/XbrGameTheme" />

        <!-- The game's files over adb, for an APK built without them: the
             shell's "content write" streams game.zip into it (the command is
             in GameZipProvider and docs/android/README.md). Exported so the
             shell's content tool reaches it; it accepts the shell and root
             users only. -->
        <provider
            android:name=".GameZipProvider"
            android:authorities="${applicationId}.gamezip"
            android:exported="true" />
    </application>
</manifest>
